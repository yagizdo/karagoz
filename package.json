{
  "name": "karagoz",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "karagoz": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js",
    "typecheck": "tsc",
    "lint": "oxlint src && prettier --check src",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  }
}
